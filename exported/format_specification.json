{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GalTransl-RPGmaker Translation File Format",
  "description": "RPG Maker MV/MZ 遊戲翻譯檔案格式說明，供 AI 翻譯代理參考",
  "version": "1.0",
  "file_structure": {
    "info": {
      "description": "翻譯檔案的元數據資訊",
      "fields": {
        "game_title": {
          "type": "string",
          "description": "遊戲原始標題"
        },
        "version": {
          "type": "string",
          "description": "翻譯檔案版本"
        },
        "string_count": {
          "type": "integer",
          "description": "總字串數量"
        }
      }
    },
    "strings": {
      "description": "可翻譯字串陣列，每個元素代表一個需要翻譯的文本條目",
      "type": "array"
    }
  },
  "strings_array_fields": {
    "index": {
      "type": "integer",
      "description": "字串在陣列中的唯一索引編號，從 0 開始遞增",
      "translation_note": "此欄位僅供定位用途，翻譯時不需修改"
    },
    "source_file": {
      "type": "string",
      "description": "此文本來源的 RPG Maker 資料檔案名稱",
      "possible_values": [
        "System.json - 系統設定、術語、選單文字",
        "CommonEvents.json - 公共事件（對話、劇情）",
        "Map*.json - 地圖事件",
        "Actors.json - 角色資料",
        "Skills.json - 技能資料",
        "Items.json - 道具資料",
        "Weapons.json - 武器資料",
        "Armors.json - 防具資料",
        "Enemies.json - 敵人資料",
        "States.json - 狀態資料",
        "Classes.json - 職業資料"
      ],
      "translation_note": "此欄位僅供參考，翻譯時不需修改"
    },
    "location": {
      "type": "string",
      "description": "文本在來源檔案中的精確位置路徑",
      "format_examples": {
        "event_dialog": "Event1/Page0/Cmd5 - 地圖事件1/頁面0/指令5",
        "common_event_dialog": "CE100/Cmd258 - 公共事件100/指令258",
        "choice": "CE84/Cmd18/Choice0 - 公共事件84/指令18/選項0",
        "event_name": "Event1/name - 事件名稱",
        "system_term": "terms/messages/actionFailure - 系統術語",
        "database_entry": "ID1/name - 資料庫項目1的名稱欄位"
      },
      "translation_note": "此欄位僅供定位用途，翻譯時不需修改"
    },
    "original": {
      "type": "string",
      "description": "原始日文文本，這是需要被翻譯的內容",
      "special_characters": {
        "\\n": "換行符號，多行對話會用此分隔",
        "\\\\N[n]": "遊戲中會顯示第 n 號角色的名稱",
        "\\\\V[n]": "遊戲中會顯示第 n 號變數的值",
        "\\\\C[n]": "文字顏色代碼",
        "\\\\G": "貨幣單位",
        "\\\\I[n]": "顯示第 n 號圖標",
        "\\\\{": "放大文字",
        "\\\\}": "縮小文字",
        "\\\\!": "等待按鍵",
        "\\\\.": "等待 1/4 秒",
        "\\\\|": "等待 1 秒"
      },
      "translation_note": "翻譯時必須保留所有特殊控制碼，僅翻譯可見文字部分"
    },
    "translated": {
      "type": "string",
      "description": "翻譯後的文本，AI 翻譯代理需要填入此欄位",
      "default": "",
      "translation_rules": [
        "將 original 欄位的日文翻譯成目標語言",
        "保留所有 \\\\N[n]、\\\\V[n]、\\\\C[n] 等控制碼不變",
        "保留 \\n 換行符號的位置（可適當調整以配合翻譯）",
        "對於選項類型(choice)，如包含條件判斷 if(s[xxx])，需保留條件部分",
        "注意翻譯長度，過長可能導致遊戲顯示問題",
        "空字串表示尚未翻譯"
      ]
    },
    "context": {
      "type": "string",
      "description": "文本的類型分類，用於判斷翻譯策略和風格",
      "possible_values": {
        "dialog": {
          "description": "對話文本",
          "priority": "高",
          "style": "自然口語化"
        },
        "choice": {
          "description": "選項文本",
          "priority": "高",
          "style": "簡潔明確",
          "note": "可能包含 if(s[xxx]) 條件需保留"
        },
        "scroll_text": {
          "description": "滾動文字",
          "priority": "高",
          "style": "文學性較強"
        },
        "picture_name": {
          "description": "圖片名稱",
          "priority": "低",
          "style": "通常不需翻譯"
        },
        "map_name": {
          "description": "地圖名稱",
          "priority": "中",
          "style": "簡短地點名稱"
        },
        "event_name": {
          "description": "事件名稱",
          "priority": "低",
          "style": "開發者參考用"
        },
        "common_event_name": {
          "description": "公共事件名稱",
          "priority": "低",
          "style": "開發者參考用"
        },
        "game_title": {
          "description": "遊戲標題",
          "priority": "高",
          "style": "精心翻譯"
        },
        "term": {
          "description": "術語",
          "priority": "中",
          "style": "業界通用翻譯"
        },
        "command": {
          "description": "選單指令",
          "priority": "高",
          "style": "簡潔動詞/名詞"
        },
        "param": {
          "description": "參數名",
          "priority": "中",
          "style": "業界通用翻譯"
        },
        "message": {
          "description": "系統訊息",
          "priority": "中",
          "style": "保留 %1 %2 佔位符"
        },
        "actor": {
          "description": "角色資料",
          "priority": "高",
          "style": "名稱可音譯或意譯"
        },
        "skill": {
          "description": "技能資料",
          "priority": "中",
          "style": "有遊戲感"
        },
        "item": {
          "description": "道具資料",
          "priority": "中",
          "style": "有遊戲感"
        },
        "weapon": {
          "description": "武器資料",
          "priority": "中",
          "style": "有遊戲感"
        },
        "armor": {
          "description": "防具資料",
          "priority": "中",
          "style": "有遊戲感"
        },
        "enemy": {
          "description": "敵人資料",
          "priority": "中",
          "style": "有威脅感"
        },
        "state": {
          "description": "狀態資料",
          "priority": "中",
          "style": "簡潔明確"
        },
        "type_name": {
          "description": "類型名稱",
          "priority": "低",
          "style": "通用類型名稱"
        },
        "debug_name": {
          "description": "除錯名稱",
          "priority": "最低",
          "style": "可跳過不翻譯"
        },
        "class": {
          "description": "職業資料",
          "priority": "中",
          "style": "符合遊戲風格"
        },
        "plugin_command": {
          "description": "插件指令",
          "priority": "低",
          "style": "通常不需翻譯"
        },
        "currency": {
          "description": "貨幣單位",
          "priority": "中",
          "style": "簡短名稱"
        }
      }
    },
    "speaker": {
      "type": "string",
      "description": "說話者名稱（如果有的話）",
      "translation_note": "此欄位可幫助理解對話語境和說話風格",
      "usage": [
        "判斷說話者性格以調整翻譯語氣",
        "保持同一角色的用語一致性"
      ]
    },
    "code": {
      "type": "integer",
      "description": "RPG Maker 事件指令代碼",
      "common_values": {
        "0": "無特定代碼（資料庫條目）",
        "101": "顯示文字指令（對話開始）",
        "102": "顯示選項指令",
        "231": "顯示圖片指令",
        "356": "插件指令",
        "401": "文字內容（對話正文）",
        "405": "滾動文字內容"
      },
      "translation_note": "此欄位僅供參考，翻譯時不需修改"
    }
  },
  "translation_examples": [
    {
      "description": "基本對話翻譯",
      "before": {
        "original": "目を覚ますと、見慣れない白い天井。",
        "translated": ""
      },
      "after": {
        "original": "目を覚ますと、見慣れない白い天井。",
        "translated": "醒來後，映入眼簾的是陌生的白色天花板。"
      }
    },
    {
      "description": "多行對話（保留換行）",
      "before": {
        "original": "こんにちは。\n元気ですか？",
        "translated": ""
      },
      "after": {
        "original": "こんにちは。\n元気ですか？",
        "translated": "你好。\n你還好嗎？"
      }
    },
    {
      "description": "帶條件的選項（保留條件）",
      "before": {
        "original": "1日目 if(s[211])",
        "translated": ""
      },
      "after": {
        "original": "1日目 if(s[211])",
        "translated": "第一天 if(s[211])"
      }
    },
    {
      "description": "系統訊息（保留佔位符）",
      "before": {
        "original": "%1は %2 のダメージを受けた！",
        "translated": ""
      },
      "after": {
        "original": "%1は %2 のダメージを受けた！",
        "translated": "%1 受到了 %2 點傷害！"
      }
    },
    {
      "description": "控制碼（保留控制碼）",
      "before": {
        "original": "\\C[2]重要\\C[0]な情報です。",
        "translated": ""
      },
      "after": {
        "original": "\\C[2]重要\\C[0]な情報です。",
        "translated": "這是\\C[2]重要\\C[0]的情報。"
      }
    }
  ],
  "ai_agent_guidelines": {
    "workflow": [
      "1. 讀取翻譯 JSON 檔案",
      "2. 遍歷 strings 陣列中的每個條目",
      "3. 根據 context 欄位判斷翻譯策略",
      "4. 翻譯 original 欄位的內容",
      "5. 將翻譯結果寫入 translated 欄位",
      "6. 保存修改後的 JSON 檔案"
    ],
    "priority_order": [
      "1. dialog / choice / scroll_text / game_title / command / actor（最優先）",
      "2. map_name / term / param / message / skill / item / weapon / armor / enemy / state / class / currency",
      "3. picture_name / event_name / common_event_name / type_name / plugin_command（可選翻譯）",
      "4. debug_name（可跳過）"
    ],
    "quality_checks": [
      "確保所有控制碼（\\\\N[n], \\\\V[n] 等）被保留",
      "確保佔位符（%1, %2 等）被保留",
      "確保條件判斷（if(s[xxx])）被保留",
      "檢查翻譯長度是否合理",
      "保持同一角色用語風格一致"
    ],
    "skip_conditions": [
      "context 為 'debug_name' 的條目可跳過",
      "context 為 'plugin_command' 且不含日文顯示文字的可跳過",
      "context 為 'picture_name' 且為純檔名的可跳過"
    ]
  }
}